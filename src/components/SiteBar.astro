---
import Logo from './Logo.astro';
import { CATEGORIES, CATEGORY_SLUGS, type CategorySlug } from '../consts';
import { categoryUrl, url } from '../utils';

interface Props {
  /** home page: fixed bar that only shows from the portfolio section downwards */
  floating?: boolean;
  current?: CategorySlug;
  /** where the "i" goes (pages without an Information section send it to the home page's) */
  infoHref?: string;
}

const { floating = false, current, infoHref = '#information' } = Astro.props;
---

<header
  class:list={['sitebar', floating ? 'sitebar--floating' : 'sitebar--sticky']}
  data-sitebar={floating ? '' : undefined}
  data-sitebar-sticky={floating ? undefined : ''}
>
  <div class="wrap sitebar__inner">
    <a class="sitebar__home" href={url('/')} aria-label="Jeffrey Wu — home">
      <Logo class="sitebar__logo" />
    </a>
    {
      floating && (
        // home page only: a quiet shortcut that glides down to The Menu (gone once you're past it)
        <a class="sitebar__skip" href="#menu" data-skip>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 5v13.5M6 12.5l6 6 6-6" />
          </svg>
          <span class="sitebar__skip-text">Skip to the Menu</span>
        </a>
      )
    }
    <nav aria-label="Categories">
      <ul class="sitebar__nav">
        {
          CATEGORY_SLUGS.map((slug) => (
            <li>
              <a href={categoryUrl(slug)} aria-current={slug === current ? 'page' : undefined}>
                {CATEGORIES[slug].label}
              </a>
            </li>
          ))
        }
        <li>
          <!-- jumps to the Information section at the very end of the page -->
          <a class="sitebar__info" href={infoHref} aria-label="Information">
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <path
                fill-rule="evenodd"
                d="M16 0a16 16 0 1 1 0 32a16 16 0 1 1 0-32Zm0 6.6a2.3 2.3 0 1 0 0 4.6a2.3 2.3 0 1 0 0-4.6Zm-2.2 7.6v10.4a2.2 2.2 0 0 0 4.4 0V14.2a2.2 2.2 0 0 0-4.4 0Z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { scrollUnderBar } from '../scroll';

  // "↓ Skip to the Menu" (home page only, 2026-10-22): glides down to The Menu, landing just under the bar.
  // Once The Menu has reached the top of the screen there's nothing left to skip to, so it fades away.
  const skip = document.querySelector<HTMLElement>('[data-skip]');
  const menu = document.querySelector<HTMLElement>('#menu .menu') ?? document.getElementById('menu');
  if (skip && menu) {
    skip.addEventListener('click', (e) => {
      e.preventDefault();
      scrollUnderBar(menu, 28);
    });
    const barEl = skip.closest<HTMLElement>('.sitebar');
    // too crowded (it would push the categories onto a second row, or nearly touch them): leave it out
    const nav = barEl?.querySelector<HTMLElement>('nav');
    const fit = () => {
      if (!nav) return;
      skip.classList.remove('is-crowded');
      if (getComputedStyle(skip).display === 'none') return; // phones: hidden by the stylesheet
      const withTop = nav.offsetTop;
      const withH = nav.offsetHeight;
      const room = nav.getBoundingClientRect().left - skip.getBoundingClientRect().right;
      skip.classList.add('is-crowded');
      const crowded = withTop !== nav.offsetTop || withH > nav.offsetHeight || room < 48;
      skip.classList.toggle('is-crowded', crowded);
    };
    // re-check whenever the bar changes width, and once the fonts have loaded (they change the words' widths)
    if (nav) new ResizeObserver(fit).observe(nav.parentElement ?? nav);
    addEventListener('resize', fit);
    document.fonts?.ready.then(fit);
    fit();
    const past = () => {
      const gone = menu.getBoundingClientRect().top <= (barEl?.offsetHeight ?? 0) + 60;
      skip.classList.toggle('is-gone', gone);
      skip.tabIndex = gone ? -1 : 0;
      skip.setAttribute('aria-hidden', String(gone));
    };
    addEventListener('scroll', past, { passive: true });
    addEventListener('resize', past);
    past();
  }

  // Floating bar (home page only): show it once About Me reaches the top of the screen,
  // and keep it for the rest of the page; hide it again when scrolling back above.
  const bar = document.querySelector<HTMLElement>('[data-sitebar]');
  const start = document.getElementById('about');
  if (bar && start) {
    let shown: boolean | null = null;
    const update = () => {
      // 100px: a little below the 84px jump offset, so "Learn More" lands with the bar showing
      const show = start.getBoundingClientRect().top <= 100;
      if (show === shown) return;
      shown = show;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    };
    bar.inert = true;
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
    update();
  }

  // Category and post pages (2026-10-11): the bar stays at the top of the screen; it slides away while you
  // scroll down (more room to read) and comes back as soon as you scroll up.
  const sticky = document.querySelector<HTMLElement>('[data-sitebar-sticky]');
  if (sticky) {
    let lastY = scrollY;
    let hidden = false;
    const setHidden = (h: boolean) => {
      if (h === hidden) return;
      hidden = h;
      sticky.classList.toggle('is-hidden', h);
    };
    // something just opened and the page is scrolling to it: stay visible until that scroll has finished
    let holding = false;
    let holdTimer = 0;
    const release = () => {
      holding = false;
      lastY = scrollY;
    };
    addEventListener('sitebar:hold', () => {
      holding = true;
      setHidden(false);
      clearTimeout(holdTimer);
      holdTimer = window.setTimeout(release, 3000); // in case the browser has no scrollend event
    });
    addEventListener('scrollend', () => {
      if (!holding) return;
      clearTimeout(holdTimer);
      holdTimer = window.setTimeout(release, 100);
    });
    const update = () => {
      const y = scrollY;
      if (holding) {
        lastY = y;
        return;
      }
      const dy = y - lastY;
      if (y <= sticky.offsetHeight) setHidden(false); // near the top: always there
      else if (dy > 6) setHidden(true); // scrolling down
      else if (dy < -6) setHidden(false); // scrolling up
      else return; // tiny moves: keep it as it is (and keep measuring from here)
      lastY = y;
    };
    let raf = 0;
    addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
    // tabbing into the bar always shows it
    sticky.addEventListener('focusin', () => setHidden(false));
  }
</script>

<style>
  .sitebar {
    background: var(--sky);
    padding: 12px 0;
  }

  .sitebar--floating {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    transform: translateY(-100%);
    transition: transform 0.35s var(--ease);
  }

  .sitebar--floating.is-shown {
    transform: none;
  }

  .sitebar--sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    transition: transform 0.35s var(--ease);
  }

  .sitebar--sticky.is-hidden {
    transform: translateY(-100%);
  }

  .sitebar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 28px;
  }

  .sitebar__home {
    display: block;
    line-height: 0;
  }

  /* the logo lives in its own component, so reach it with :global */
  .sitebar__home {
    padding: 4px 0;
  }

  .sitebar__home :global(.sitebar__logo) {
    font-size: clamp(34px, 3.4vw, 44px);
    transition: transform 0.25s var(--ease);
  }

  .sitebar__home:hover :global(.sitebar__logo),
  .sitebar__home:focus-visible :global(.sitebar__logo) {
    transform: translateY(-1px) scale(1.03);
  }

  /* "↓ Skip to the Menu": small, grey and quiet, like "← MAIN PAGE"; on hover it darkens and the arrow dips */
  .sitebar__skip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: auto; /* sits next to the logo; the categories stay on the right */
    padding: 4px 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 0.2s var(--ease),
      opacity 0.35s var(--ease),
      visibility 0.35s;
  }

  .sitebar__skip svg {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s var(--ease);
  }

  .sitebar__skip:hover,
  .sitebar__skip:focus-visible {
    color: var(--ink);
  }

  .sitebar__skip:hover svg,
  .sitebar__skip:focus-visible svg {
    transform: translateY(2px);
  }

  /* past The Menu: nothing to skip to */
  .sitebar__skip.is-gone {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .sitebar__skip.is-crowded {
    display: none;
  }

  .sitebar__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px clamp(14px, 2.2vw, 30px);
  }

  .sitebar__nav a {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    font-weight: 500;
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.25s var(--ease);
  }

  .sitebar__nav a:hover,
  .sitebar__nav a:focus-visible {
    border-bottom-color: var(--ink);
  }

  .sitebar__nav a[aria-current='page'] {
    border-bottom-color: var(--butter);
  }

  .sitebar__nav li:has(.sitebar__info) {
    display: flex;
    align-items: center;
  }

  /* the "i": an ink disc with the i cut out (so the bar's blue shows through); all butter on hover */
  .sitebar__nav .sitebar__info {
    display: block;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    color: var(--ink);
    transition:
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .sitebar__nav .sitebar__info:hover,
  .sitebar__nav .sitebar__info:focus-visible {
    color: var(--butter);
    border: 0;
    transform: scale(1.06);
  }

  .sitebar__info svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* phone: compact, logo and links on one tidy block */
  @media (max-width: 600px) {
    .sitebar {
      padding: 8px 0;
    }
    .sitebar__inner {
      gap: 6px 10px;
    }
    .sitebar__home :global(.sitebar__logo) {
      font-size: 27px;
    }
    .sitebar__nav {
      gap: 2px 6px;
      flex-wrap: nowrap; /* links and the "i" stay on one line */
      align-items: center;
    }
    .sitebar__nav a {
      font-size: 0.71rem; /* five categories + "i" next to the logo on one row (since Misc, 2026-10-26) */
      padding: 2px 0;
      white-space: nowrap;
    }
    .sitebar__nav .sitebar__info {
      width: 24px;
      height: 24px;
    }
    /* phones: no skip link at all (too crowded beside the logo and the four links) */
    .sitebar__skip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sitebar--floating {
      transition: none;
    }
  }
</style>
