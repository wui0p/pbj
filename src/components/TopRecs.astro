---
// Top Suggestions: four flat icons with a small card on hover; clicking opens the link. Used in STORY = ART on
// the home page and on the Thoughts page, the same size in both.
// The helmet goes to my own Goodreads review, the record to the EPIC section of the Bravo Songs post, the sword
// to my thoughts on Frieren on the Series page (same tab), and the island to Rich & Poor on YouTube.
import { url } from '../utils';

const recs: { id: string; title: string; desc: string; cta: string; url: string; internal?: boolean }[] = [
  {
    id: 'helmet',
    title: 'Song of Achilles · novel',
    desc: 'The <em>Iliad</em> retold as a love story through the eyes of Achilles’ companion, Patroclus',
    cta: 'Click to know more',
    // my review of it on Goodreads
    url: 'https://www.goodreads.com/review/show/8808899677',
  },
  {
    id: 'record',
    title: 'EPIC · musical',
    desc: 'Odysseus fights his way home and learns that each act of mercy, cunning, and cruelty has a price',
    cta: 'Click to know more',
    // the EPIC section of my Bravo Songs post, on this site
    url: url('/blog/bravo-songs/#epic-the-musical'),
    internal: true,
  },
  {
    id: 'sword',
    title: 'Frieren · anime',
    desc: 'An elf who outlives her friends sets out to finally understand the people she lost',
    cta: 'Click to know more',
    // my thoughts on it, opened under its banner on the Series page
    url: url('/blog/series-list/#frieren'),
    internal: true,
  },
  {
    id: 'island',
    title: 'Rich & Poor · movie',
    desc: 'A long Minecraft YouTube video. You don’t need to understand Minecraft to enjoy this masterpiece, in which 1,000 players simulate civilizations.',
    cta: 'Click to go watch',
    url: 'https://www.youtube.com/watch?v=ef568d0CrRY&t=8090s',
  },
];
---

<div class="top-recs">
  <h3 class="heading recs-title">Top Suggestions</h3>
  <ul class="recs">
    {
      recs.map((r, i) => (
        <li class:list={['rec', `rec--${r.id}`, { 'rec--end': i >= 2 }]}>
          <a
            class="rec__link"
            href={r.url}
            target={r.internal ? undefined : '_blank'}
            rel={r.internal ? undefined : 'noopener noreferrer'}
            aria-describedby={`rec-${r.id}`}
          >
            <span class="sr-only">{r.title.split(' · ')[0]}</span>
            {r.id === 'helmet' && (
              <svg class="rec__icon" viewBox="0 0 96 96" aria-hidden="true">
                <g class="i-lift">
                  <path class="i-sky" d="M28 24 C30 6 66 6 68 24 C62 14 34 14 28 24 Z" />
                  <path
                    class="i-butter"
                    d="M18 54 C18 28 32 16 48 16 C64 16 78 28 78 54 L78 80 Q78 86 72 86 L62 86 Q58 86 58 82 L58 62 L52 56 L52 50 L44 50 L44 56 L38 62 L38 82 Q38 86 34 86 L24 86 Q18 86 18 80 Z"
                  />
                  <path class="i-ink" d="M26 42 L44 42 L44 50 L31 50 Q26 48 26 42 Z" />
                  <path class="i-ink" d="M70 42 L52 42 L52 50 L65 50 Q70 48 70 42 Z" />
                </g>
              </svg>
            )}
            {r.id === 'record' && (
              <svg class="rec__icon" viewBox="0 0 96 96" aria-hidden="true">
                <g class="i-spin">
                  <circle class="i-ink" cx="48" cy="48" r="40" />
                  <path class="i-groove" d="M48 22 A26 26 0 0 1 74 48" />
                  <circle class="i-butter" cx="48" cy="48" r="15" />
                  <circle class="i-paper" cx="48" cy="48" r="4" />
                </g>
              </svg>
            )}
            {r.id === 'sword' && (
              <svg class="rec__icon" viewBox="0 0 96 96" aria-hidden="true">
                <g class="i-pull">
                  <rect class="i-sky" x="44.5" y="20" width="7" height="50" rx="1.5" />
                  <rect class="i-ink" x="45" y="6" width="6" height="13" rx="2" />
                  <rect class="i-butter" x="33" y="17" width="30" height="7" rx="3" />
                  <circle class="i-butter" cx="48" cy="5" r="3.5" />
                </g>
                <path class="i-sand" d="M12 86 C16 66 32 58 48 58 C64 58 80 66 84 86 Z" />
              </svg>
            )}
            {r.id === 'island' && (
              <svg class="rec__icon" viewBox="0 0 96 96" aria-hidden="true">
                <path class="i-sky" d="M4 78 C16 69 80 69 92 78 C80 90 16 90 4 78 Z" />
                <g class="i-sway">
                  <path class="i-sand" d="M44 68 C45 50 49 36 56 25 L62 28 C56 38 53 52 53 68 Z" />
                  <path class="i-ink" d="M59 25 C50 11 33 11 22 25 C35 20 47 20 59 25 Z" />
                  <path class="i-ink" d="M59 25 C45 24 35 33 33 46 C41 35 49 29 59 25 Z" />
                  <path class="i-ink" d="M59 25 C66 11 81 9 92 19 C81 17 69 20 59 25 Z" />
                  <path class="i-ink" d="M59 25 C73 22 83 31 85 44 C77 34 69 28 59 25 Z" />
                </g>
                <path class="i-butter" d="M20 75 C26 60 68 60 76 75 C62 80 34 80 20 75 Z" />
              </svg>
            )}
          </a>
          <div class="rec__tip depth" id={`rec-${r.id}`} role="tooltip">
            <p class="rec__name">{r.title}</p>
            <p class="rec__desc" set:html={r.desc} />
            <p class="rec__cta">{r.cta} →</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .recs-title {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    margin: 0 0 clamp(14px, 1.6vw, 20px);
  }

  .recs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 40px);
  }

  .rec {
    position: relative;
  }

  .rec__link {
    display: block;
    border-radius: 16px;
    padding: 6px;
  }

  .rec__link:focus-visible {
    outline: 3px solid var(--ink);
  }

  .rec__icon {
    display: block;
    width: clamp(64px, 6.5vw, 84px);
    height: auto;
    overflow: visible;
  }

  /* one flat family: ink outline, palette fills, no inner detail */
  .rec__icon :global(path),
  .rec__icon :global(circle),
  .rec__icon :global(rect) {
    stroke: var(--ink);
    stroke-width: 3.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .rec__icon .i-butter {
    fill: var(--butter);
  }
  .rec__icon .i-sky {
    fill: var(--sky);
  }
  .rec__icon .i-ink {
    fill: var(--ink);
  }
  .rec__icon .i-paper {
    fill: var(--paper);
    stroke: none;
  }
  .rec__icon .i-groove {
    fill: none;
    stroke: var(--sky);
    stroke-width: 3;
  }
  .rec__icon .i-sand {
    fill: var(--sand);
  }

  .rec__icon g {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition: transform 0.45s var(--ease);
  }

  /* hover / keyboard focus: each icon moves its own way */
  .rec--helmet .rec__link:is(:hover, :focus-visible) .i-lift {
    transform: translateY(-12px) rotate(-8deg);
  }

  .rec--record .rec__link:is(:hover, :focus-visible) .i-spin {
    animation: spin 3.2s linear infinite;
  }

  /* the sword is pulled up out of the stone */
  .rec--sword .i-pull {
    transform-origin: 50% 100%;
  }
  .rec--sword .rec__link:is(:hover, :focus-visible) .i-pull {
    transform: translateY(-18px);
  }

  /* the palm tree sways in the wind, from its foot */
  .rec--island .i-sway {
    transform-origin: 40% 100%;
  }
  .rec--island .rec__link:is(:hover, :focus-visible) .i-sway {
    animation: sway 2.4s ease-in-out infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg);
    }
    75% {
      transform: rotate(5deg);
    }
  }

  /* the small card that says what it is */
  .rec__tip {
    --depth: 6px;
    position: absolute;
    z-index: 5;
    top: calc(100% + 10px);
    left: 0;
    width: 250px;
    padding: 14px 16px;
    background: var(--sand);
    border-radius: 16px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease),
      visibility 0.2s;
    pointer-events: none;
  }

  .rec--end .rec__tip {
    left: auto;
    right: 0;
  }

  .rec:is(:hover, :focus-within) .rec__tip {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .rec__tip p {
    margin: 0;
  }

  .rec__name {
    font-weight: 800;
    font-size: 1rem;
    margin-bottom: 0.3rem !important;
  }

  .rec__desc {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .rec__cta {
    margin-top: 0.6rem !important;
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* phones / touch: no hover, so the cards are always shown under the icons */
  @media (hover: none) {
    .recs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    }
    .rec {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .rec__tip {
      position: static;
      width: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: none;
      padding: 4px 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec__icon g,
    .rec__icon .i-spin,
    .rec__icon .i-sway {
      animation: none !important;
      transition: none;
    }
  }
</style>
