---
// One section per album (Bravo Songs): the cover with the title and first paragraph beside
// it, the rest of the text under them (and a second picture on the right, if there is one), then a strip from
// wall to wall in three patterned bands. When the strip scrolls up to a third of the way from the bottom of the
// screen, its middle band parts (the top and bottom bands stay) and shows the album's line ("Click to Travel
// with Odysseus"). The whole strip opens the album's link.
// Strip patterns: greek = Greek key / wave scrolls / bars (EPIC); meadow = wheat stalks / rolling hills / grass
// ticks (The Golden Years); hardsoft = sharp zigzag ("hard") / bubbles (underwater) / round scallops ("soft")
// (HIT ME HARD AND SOFT).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  albums: {
    title: string;
    by?: string;
    cover: ImageMetadata;
    alt: string;
    photo?: ImageMetadata;
    photoAlt?: string;
    photoCredit?: { author: string; source: string; license: string; licenseUrl: string };
    link?: string;
    call: string;
    strip: 'greek' | 'meadow' | 'hardsoft';
    text: string[];
  }[];
}

const { albums } = Astro.props;
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

{
  albums.map((a, i) => {
    const Strip = a.link ? 'a' : 'div';
    const meadow = a.strip === 'meadow';
    return (
      // id from the title ("EPIC: The Musical" → #epic-the-musical), so Top Suggestions can link straight here
      <section class="album" id={slug(a.title)} aria-labelledby={`album-${i}`}>
        <div class:list={['album__top', { 'album__top--wide': a.cover.width > a.cover.height }]}>
          <Image class="album__cover" src={a.cover} alt={a.alt} widths={[300, 460, 920]} sizes="(max-width: 640px) 92vw, 460px" />
          <div>
            <h2 class="album__title" id={`album-${i}`}>
              {a.title}
              {a.by && <span class="album__by">by {a.by}</span>}
            </h2>
            <p>{a.text[0]}</p>
          </div>
        </div>
        {a.photo ? (
          // with a second picture: the rest of the text on the left, the picture on the right
          // (a landscape picture gets a wider column)
          <div class:list={['album__rest', { 'album__rest--wide': a.photo.width > a.photo.height }]}>
            <div>
              {a.text.slice(1).map((t) => (
                <p>{t}</p>
              ))}
            </div>
            <figure class="album__figure">
              <Image class="album__photo" src={a.photo} alt={a.photoAlt ?? ''} widths={[280, 420, 840]} sizes="(max-width: 640px) 60vw, 420px" />
              {a.photoCredit && (
                <figcaption class="album__credit">
                  Photo: <a href={a.photoCredit.source} target="_blank" rel="noopener noreferrer">{a.photoCredit.author}</a>,{' '}
                  <a href={a.photoCredit.licenseUrl} target="_blank" rel="noopener noreferrer">{a.photoCredit.license}</a>
                </figcaption>
              )}
            </figure>
          </div>
        ) : (
          a.text.slice(1).map((t) => <p>{t}</p>)
        )}

        <Strip
          class:list={['strip', { 'strip--nolink': !a.link }]}
          href={a.link}
          target={a.link ? '_blank' : undefined}
          rel={a.link ? 'noopener noreferrer' : undefined}
          aria-label={a.link ? `${a.call} (opens in a new tab)` : undefined}
          aria-hidden={a.link ? undefined : 'true'}
          data-strip
        >
          <svg class="strip__defs" aria-hidden="true" focusable="false">
            <defs>
              {a.strip === 'hardsoft' ? (
                <>
                  {/* "hard": a sharp zigzag, all corners */}
                  <pattern id={`top-${i}`} width="20" height="28" patternUnits="userSpaceOnUse">
                    <path
                      d="M0 24L10 4L20 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linejoin="miter"
                      stroke-miterlimit="10"
                    />
                  </pattern>
                  {/* underwater: bubbles of different sizes, a few with a little shine */}
                  <pattern id={`mid-${i}`} width="120" height="34" patternUnits="userSpaceOnUse">
                    <g fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="10" cy="20" r="7" />
                      <circle cx="27" cy="9" r="3" />
                      <circle cx="39" cy="24" r="4.5" />
                      <circle cx="56" cy="15" r="8.5" />
                      <circle cx="73" cy="27" r="3" />
                      <circle cx="86" cy="12" r="5" />
                      <circle cx="102" cy="22" r="6.5" />
                      <circle cx="115" cy="7" r="2.5" />
                      <path d="M5.5 17A4.5 4.5 0 0 1 9 14M50.5 12A5.5 5.5 0 0 1 55 8.5M98 19.5A4 4 0 0 1 101 17" stroke-width="1.4" stroke-linecap="round" />
                    </g>
                  </pattern>
                  {/* "soft": round scallops, no corners */}
                  <pattern id={`bot-${i}`} width="16" height="16" patternUnits="userSpaceOnUse">
                    <path d="M0 14A8 8 0 0 1 16 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                  </pattern>
                </>
              ) : meadow ? (
                <>
                  {/* wheat stalks along the top */}
                  <pattern id={`top-${i}`} width="24" height="28" patternUnits="userSpaceOnUse">
                    {/* a tall stalk and a shorter one */}
                    <path d="M7 28V3M17 28V10" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <path
                      d="M7 7C3 6 2 2.5 3 0.5C6 1.5 7 4 7 7ZM7 7C11 6 12 2.5 11 0.5C8 1.5 7 4 7 7ZM7 13C3 12 2 8.5 3 6.5C6 7.5 7 10 7 13ZM7 13C11 12 12 8.5 11 6.5C8 7.5 7 10 7 13ZM7 19C3 18 2 14.5 3 12.5C6 13.5 7 16 7 19ZM7 19C11 18 12 14.5 11 12.5C8 13.5 7 16 7 19ZM17 14C13.5 13 12.5 10 13.5 8C16 9 17 11 17 14ZM17 14C20.5 13 21.5 10 20.5 8C18 9 17 11 17 14ZM17 20C13.5 19 12.5 16 13.5 14C16 15 17 17 17 20ZM17 20C20.5 19 21.5 16 20.5 14C18 15 17 17 17 20Z"
                      fill="currentColor"
                    />
                  </pattern>
                  {/* soft rolling hills in the middle: uneven near hills, a thinner far ridge behind */}
                  <pattern id={`mid-${i}`} width="240" height="34" patternUnits="userSpaceOnUse">
                    {/* both lines start and end level, so one tile flows into the next without a corner */}
                    <path
                      d="M0 15C30 15 60 6 100 7C140 8 160 17 190 16C215 15 230 15 240 15"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                    />
                    <path
                      d="M0 27C20 27 40 12 70 12C100 12 110 27 135 27C160 27 175 17 200 18C222 19 230 27 240 27"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                    />
                  </pattern>
                  {/* little clumps of grass along the bottom */}
                  <pattern id={`bot-${i}`} width="16" height="16" patternUnits="userSpaceOnUse">
                    <path
                      d="M2 16Q2.5 11 0.5 7M4.5 16Q4.5 10 6 5M7 16Q7.5 12 9.5 9M11.5 16Q11.5 13 10.5 11M13.5 16Q14 12 15.5 10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </pattern>
                </>
              ) : (
                <>
                  {/* Greek key along the top */}
                  <pattern id={`top-${i}`} width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M0 25.5H28M3 25.5V3H24V21H9V9H18V15" fill="none" stroke="currentColor" stroke-width="3" />
                  </pattern>
                  {/* running wave scrolls in the middle */}
                  <pattern id={`mid-${i}`} width="34" height="34" patternUnits="userSpaceOnUse">
                    <path
                      d="M0 29C7 29 9 24 9 17A8 8 0 1 1 25 17A4.5 4.5 0 1 1 16 17M25 17C25 24 27 29 34 29"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                    />
                  </pattern>
                  {/* thin upright bars along the bottom */}
                  <pattern id={`bot-${i}`} width="7" height="16" patternUnits="userSpaceOnUse">
                    <rect x="2" y="0" width="3" height="16" fill="currentColor" />
                  </pattern>
                </>
              )}
            </defs>
          </svg>
          <svg class="strip__band strip__band--top" aria-hidden="true" focusable="false">
            <rect width="100%" height="100%" fill={`url(#top-${i})`} />
          </svg>
          <span class="strip__middle">
            <span class="strip__call" aria-hidden="true">
              {a.call}
            </span>
            {/* the middle band in two halves that slide apart; each half draws the whole band so the pattern meets in the middle */}
            <span class="strip__half strip__half--left" aria-hidden="true">
              <svg focusable="false">
                <rect width="100%" height="100%" fill={`url(#mid-${i})`} />
              </svg>
            </span>
            <span class="strip__half strip__half--right" aria-hidden="true">
              <svg focusable="false">
                <rect width="100%" height="100%" fill={`url(#mid-${i})`} />
              </svg>
            </span>
          </span>
          <svg class="strip__band strip__band--bottom" aria-hidden="true" focusable="false">
            <rect width="100%" height="100%" fill={`url(#bot-${i})`} />
          </svg>
        </Strip>
      </section>
    );
  })
}

<script>
  // part the middle band once the strip is a third of the way up from the bottom of the screen
  // (and close it again below that line)
  const strips = document.querySelectorAll<HTMLElement>('[data-strip]');
  if (strips.length) {
    if (!('IntersectionObserver' in window)) {
      strips.forEach((s) => s.classList.add('is-open'));
    } else {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('is-open', e.isIntersecting)),
        { rootMargin: '0px 0px -33% 0px' },
      );
      strips.forEach((s) => io.observe(s));
    }
  }
</script>

<style>
  .album {
    margin-top: clamp(28px, 3.5vw, 48px);
    scroll-margin-top: var(--jump-at); /* a jump here (Top Suggestions' record) lands a third of the way down */
  }

  .album + .album {
    margin-top: clamp(64px, 9vw, 120px);
  }

  /* the album's text: the story serif (Times-like), justified */
  .album p {
    margin: 1.25em 0 0;
    text-align: justify;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .album__top {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(24px, 3.5vw, 48px);
    align-items: start;
  }

  /* a landscape picture (The Golden Years) gets a wider column, like the mockup */
  .album__top--wide {
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
  }

  .album__top p {
    margin-top: 1.6em;
  }

  /* a little more room between the cover and the text under it */
  .album__top + p {
    margin-top: clamp(28px, 3.5vw, 44px);
  }

  .album__cover {
    display: block;
    width: 100%;
    height: auto;
  }

  /* a second picture, on the right, with the rest of the text beside it on the left */
  .album__rest {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    gap: clamp(24px, 3.5vw, 48px);
    align-items: start;
    margin-top: clamp(20px, 2.5vw, 32px);
  }

  /* a landscape picture (Billie Eilish) gets a wider column */
  .album__rest--wide {
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
  }

  .album__figure {
    margin: 1.25em 0 0; /* top level with the first line of the text beside it */
  }

  .album__photo {
    display: block;
    width: 100%;
    height: auto;
  }

  /* who took a licensed photo, and its licence: small and grey, under the picture */
  .album__credit {
    margin-top: 6px;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ink-soft);
    text-align: right;
  }

  .album__credit a {
    color: inherit;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 2px;
  }

  .album__credit a:hover {
    color: var(--ink);
  }

  .album__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
  }

  /* "by Jorge Rivera-Herrans": the same bold serif, smaller, on its own line */
  .album__by {
    display: block;
    margin-top: 0.3em;
    font-size: 0.6em;
    line-height: 1.2;
  }

  /* ----- the Greek strip, wall to wall ----- */
  .strip {
    --key: 28px;
    --wave: 34px;
    --bars: 16px;
    --line: 3px;
    position: relative;
    display: grid;
    width: 100vw;
    margin: clamp(48px, 6vw, 80px) 0 0 calc(50% - 50vw);
    background: var(--butter);
    color: var(--ink);
    text-decoration: none;
    border-block: var(--line) solid var(--ink);
    cursor: pointer;
  }

  /* no link yet: same strip, nothing to click */
  .strip--nolink {
    cursor: default;
  }

  .strip:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .strip__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  .strip__band {
    display: block;
    width: 100%;
  }

  .strip__band--top {
    height: var(--key);
    margin-top: 4px;
  }

  .strip__band--bottom {
    height: var(--bars);
    border-top: var(--line) solid var(--ink);
    margin-top: 4px;
  }

  .strip__middle {
    position: relative;
    display: grid;
    place-items: center;
    height: calc(var(--wave) + 10px);
    margin-top: 4px;
    border-top: var(--line) solid var(--ink);
    overflow: hidden;
  }

  .strip__call {
    font-weight: 800;
    font-size: clamp(0.85rem, 1.7vw, 1.3rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .strip__half {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    overflow: hidden;
    background: var(--butter);
    transition: transform 2.5s var(--ease);
  }

  .strip__half--left {
    left: 0;
  }

  .strip__half--right {
    right: 0;
  }

  .strip__half svg {
    position: absolute;
    top: 5px;
    width: 200%;
    height: var(--wave);
  }

  .strip__half--left svg {
    left: 0;
  }

  .strip__half--right svg {
    right: 0;
  }

  .strip.is-open .strip__half--left,
  .strip:hover .strip__half--left,
  .strip:focus-visible .strip__half--left {
    transform: translateX(-101%);
  }

  .strip.is-open .strip__half--right,
  .strip:hover .strip__half--right,
  .strip:focus-visible .strip__half--right {
    transform: translateX(101%);
  }

  @media (max-width: 640px) {
    .album__top {
      grid-template-columns: 1fr;
    }
    .album__cover {
      width: min(70vw, 300px);
    }
    .album__top--wide .album__cover {
      width: 100%;
    }
    /* phones: the picture goes under the text, on the right */
    .album__rest {
      grid-template-columns: 1fr;
    }
    .album__figure {
      width: min(60%, 240px);
      margin-left: auto;
    }
    .album__rest--wide .album__figure {
      width: 100%;
    }
    .strip {
      --key: 22px;
      --wave: 30px;
      --bars: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__half {
      transition: none;
    }
  }
</style>
