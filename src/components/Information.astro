---
import { LINKS } from '../consts';
import { categoryUrl } from '../utils';

// The email is never written as plain text, in the HTML or in this source (which is public on GitHub).
// It's kept here already reversed, in two parts, and the script below turns it back round in the browser.
const user = '3322sakymsak';
const domain = 'moc.liamg';
const year = new Date().getFullYear();
---

<footer class="info" id="information" aria-labelledby="info-heading">
  <div class="wrap">
    <h2 class="heading info__heading" id="info-heading">Information</h2>

    <div class="info__body">
      <div class="info__who">
        <p class="info__name">Jeffrey Wu</p>
        <p class="info__line">NCHU Electrical Engineering · Undergraduate, Senior</p>
        <p class="info__line">Lab EE612</p>
      </div>

      <dl class="info__contact">
        <div>
          <dt class="eyebrow">Email</dt>
          <dd>
            <span class="info__email" data-u={user} data-d={domain}>
              <noscript>Turn on JavaScript to see the email address.</noscript>
            </span>
            <button class="info__copy" type="button" data-copy hidden>Copy</button>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">GitHub</dt>
          <dd>
            <a class="info__link" href={LINKS.github} rel="me">github.com/wui0p</a>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">LinkedIn</dt>
          <dd>
            <a class="info__link" href={LINKS.linkedin} rel="me">linkedin.com/in/jeffrey-wu</a>
          </dd>
        </div>
      </dl>
    </div>

    <!-- a small note at the very end (2026-10-28): not the point of this section, so it stays quiet -->
    <p class="info__ai">
      <span class="info__ai-tag">AI Disclosure</span>
      <span>Written and designed by Jeffrey Wu (a human). Built with help from AI tools for coding and grammar only.</span>
      <!-- opens the Misc answer "Did you design this website yourself?" (2026-10-29) -->
      <a class="info__ai-link" href={`${categoryUrl('misc')}#design`}>How I designed it <span aria-hidden="true">→</span></a>
    </p>
    <p class="info__fine">© {year} Jeffrey Wu</p>
  </div>
</footer>

<script>
  const holder = document.querySelector<HTMLElement>('.info__email');
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (holder) {
    const rev = (s = '') => s.split('').reverse().join('');
    const address = `${rev(holder.dataset.u)}@${rev(holder.dataset.d)}`;
    const link = document.createElement('a');
    link.className = 'info__link';
    link.href = `mailto:${address}`;
    link.textContent = address;
    holder.replaceChildren(link);

    if (copyBtn && navigator.clipboard) {
      copyBtn.hidden = false;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(address);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Copy failed';
        }
        window.setTimeout(() => (copyBtn.textContent = 'Copy'), 1800);
      });
    }
  }
</script>

<style>
  /* at least a whole screen tall (2026-10-28): the "i" jumps here and the screen turns all sky, with nothing of the
     section above showing; the AI note and the © line sit at the bottom */
  .info {
    background: var(--sky);
    padding: clamp(72px, 10vw, 140px) 0 clamp(40px, 5vw, 64px);
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .info > .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .info__heading {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .info__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 96px);
    border-top: 1px solid var(--ink-faint);
    padding-top: clamp(36px, 5vw, 64px);
  }

  .info__name {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .info__line {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .info__contact {
    margin: 0;
    display: grid;
    gap: 1.6rem;
    align-content: start;
    padding-top: 0.6rem;
  }

  .info__contact dd {
    margin: 0.3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }

  .info__email :global(.info__link),
  .info__link {
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .info__email :global(.info__link:hover),
  .info__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .info__copy {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .info__copy:hover {
    color: var(--ink);
  }

  /* the AI note: as small as the © line, with a little ink tag in front */
  .info__ai {
    margin: auto 0 0;
    padding-top: clamp(64px, 9vw, 120px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .info__ai-tag {
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* quiet like the note itself: ink, thinly underlined, the arrow nudges on hover */
  .info__ai-link {
    color: var(--ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info__ai-link span {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }

  .info__ai-link:hover span,
  .info__ai-link:focus-visible span {
    transform: translateX(3px);
  }

  .info__fine {
    margin: 10px 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .info__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
