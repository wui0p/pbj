---
import { Image } from 'astro:assets';
import athens from '../assets/education/school-of-athens.jpg';
import { categoryUrl } from '../utils';
import { TEACHING_STATS } from '../consts';
// The teaching jobs themselves (photos, descriptions, stats) live on the Teaching page since v15:
// src/content/blog/teaching-*.md
---

<section class="edu" id="education" aria-labelledby="edu-heading">
  <div class="wrap edu__grid">
    <div class="edu__text serif-text" data-reveal>
      <p class="edu__quote">
        <span class="hl">“Anyone can cook.”</span> — Gusteau, <em>Ratatouille</em>
      </p>
      <p>
        In elementary school, I was among the bottom students. But the teacher noticed my improvement and told me,
        giving me encouragement. <span class="hl" style="--hl-delay: 0.6s"
          >From what I've experienced, every small validation can accumulate into greatness.</span
        >
      </p>
      <p>Now I try to be that teacher. Here is where I’ve been doing that:</p>
      <ul class="edu__list">
        <li>TA, Electronics (II)</li>
        <li>Educator, “Physics World” exhibition</li>
        <li>Physics TA &amp; tutor, private institute</li>
      </ul>

      <!-- the same numbers as beside the Teaching page's painting (TEACHING_STATS in consts.ts) -->
      <ul class="edu__stats">
        {TEACHING_STATS.map((s) => <li class="depth">{s.num} {s.label}</li>)}
      </ul>

      <!-- goes to the Teaching page, where each job opens with its photo and details -->
      <a class="btn-3d btn-3d--butter depth" href={categoryUrl('teaching')}>See detailed teaching work</a>
    </div>

    <!-- EDUCATION travels down this column as you scroll, leaving outlined "shells" behind -->
    <div class="edu__art" data-edu-art>
      <p class="art-caption edu__caption" data-note="The next Renaissance is near us.">* Raphael, <em>The School of Athens</em>, 1509–1511</p>
      <div class="edu__paint" data-paint>
        <Image
          src={athens}
          alt="Raphael's The School of Athens: philosophers gathered on the steps of a great hall"
          widths={[700, 1100, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 46vw"
          class="edu__img"
          loading="lazy"
        />
        <!-- white copy of the word, only visible where it sits on the painting -->
        <span class="heading edu__word edu__word--knock" aria-hidden="true">Education</span>
      </div>
      <div class="edu__shells" data-shells aria-hidden="true"></div>
      <h2 class="heading edu__word edu__word--main" id="edu-heading" data-word>Education</h2>
    </div>
  </div>
</section>

<script>
  // ---------- EDUCATION follows the scroll down its column, leaving shells ----------
  const art = document.querySelector<HTMLElement>('[data-edu-art]');
  const word = art?.querySelector<HTMLElement>('[data-word]');
  const paint = art?.querySelector<HTMLElement>('[data-paint]');
  const shellsEl = art?.querySelector<HTMLElement>('[data-shells]');

  if (art && word && paint && shellsEl) {
    let y0 = 0;
    let y1 = 0;
    let shells: { el: HTMLElement; y: number }[] = [];
    const moving = matchMedia('(min-width: 901px) and (prefers-reduced-motion: no-preference)');

    const shell = (cls: string, y: number, o: number, parent: HTMLElement) => {
      const s = document.createElement('span');
      s.className = `edu__shell heading ${cls}`;
      s.textContent = 'Education';
      s.setAttribute('aria-hidden', 'true');
      s.style.top = `${y}px`;
      s.style.setProperty('--o', String(o));
      parent.append(s);
      return s;
    };

    const layout = () => {
      const wordH = word.offsetHeight;
      const paintBottom = paint.offsetTop + paint.offsetHeight;
      art.style.setProperty('--pt', `${paint.offsetTop}px`);
      y0 = paintBottom - wordH * 0.55; // starts half on the painting
      y1 = Math.max(y0, art.offsetHeight - wordH); // ends level with the bottom of the text column
      shellsEl.replaceChildren();
      paint.querySelectorAll('.edu__shell').forEach((s) => s.remove());
      shells = [];
      if (moving.matches && y1 - y0 > wordH) {
        const fs = parseFloat(getComputedStyle(word).fontSize);
        // dense, even rhythm from the painting down to where the word stops
        const n = Math.max(1, Math.round((y1 - y0) / (fs * 0.4)));
        const step = (y1 - y0) / n;
        for (let k = 0; k < n; k++) {
          const y = y0 + k * step;
          // older shells are lighter; the first one (under the painting) a bit stronger
          const s = shell('', y, k === 0 ? 0.65 : 0.3 + 0.5 * (k / n), shellsEl);
          shells.push({ el: s, y });
        }
        // where the word started, it stays printed white on the painting
        const w = shell('edu__shell--paint', y0 - paint.offsetTop, 1, paint);
        shells.push({ el: w, y: y0 });
      }
      update();
    };

    const update = () => {
      let wy = y0;
      if (moving.matches) {
        const r = art.getBoundingClientRect();
        const target = innerHeight * 0.55 - r.top - word.offsetHeight / 2; // keep it near mid-screen
        wy = Math.min(y1, Math.max(y0, target));
      }
      art.style.setProperty('--wy', `${wy}px`);
      for (const s of shells) s.el.classList.toggle('is-left', wy >= s.y + 4);
    };

    let raf = 0;
    addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });
    addEventListener('resize', layout);
    moving.addEventListener('change', layout);
    document.fonts?.ready.then(layout);
    new ResizeObserver(layout).observe(art);
    layout();
  }
</script>

<style>
  .edu {
    background: var(--paper);
    padding: var(--sec-top) 0 var(--sec-bot);
  }

  .edu__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 72px);
  }

  /* ----- the text column ----- */
  .edu__text p,
  .edu__text li {
    margin: 0 0 1em;
  }

  .edu__quote {
    font-size: clamp(1.2rem, 1.6vw, 1.45rem) !important;
  }

  .edu__list {
    margin: -0.4em 0 1.6em;
    padding-left: 1.3em;
  }

  .edu__list li {
    margin: 0.15em 0 !important;
    text-align: left;
  }

  /* all three bars identical: one font size that always fits the longest line on one row */
  .edu__stats {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0 10px 10px 0;
    display: grid;
    gap: 22px;
    container-type: inline-size;
  }

  .edu__stats li {
    --depth: 8px;
    margin: 0 !important;
    font-family: var(--font-sans) !important;
    font-size: min(2rem, 5.3cqi) !important;
    font-weight: 800;
    line-height: 1.15 !important;
    white-space: nowrap;
    color: var(--ink);
    background: var(--sand);
    border-radius: 18px;
    padding: 0.55em 0.8em;
  }

  /* ----- the painting column ----- */
  .edu__art {
    position: relative;
    container-type: inline-size;
  }

  /* sits just above the torn edge (the cut-away top is ~17% of the painting's height) */
  .edu__caption {
    position: relative;
    z-index: 2;
    margin: 0 0 calc(0.4rem - 6.4cqi);
  }

  /* cut along the philosophers' heads (the hall above is cut away), like AI & BRAIN;
     the clip also keeps the white copy of the word on the painting only */
  .edu__paint {
    position: relative;
    z-index: 1;
    overflow: hidden;
    clip-path: polygon(
      0% 18%,
      3% 14%,
      6% 16%,
      9% 21%,
      13% 15.5%,
      17% 17%,
      21% 15.5%,
      24.5% 19.5%,
      28% 18%,
      31% 16.5%,
      34.5% 19.5%,
      38% 21.5%,
      41% 19%,
      44.5% 16.5%,
      47.5% 19%,
      51% 17%,
      54.5% 20%,
      58% 19%,
      61.5% 17.5%,
      65% 21%,
      68.5% 23.5%,
      72% 26%,
      75.5% 22%,
      79% 20.5%,
      82.5% 23%,
      85.5% 19%,
      88.5% 19.5%,
      91% 22%,
      94% 19%,
      97% 17.5%,
      100% 20.5%,
      100% 100%,
      0% 100%
    );
  }

  .edu__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .edu__word {
    margin: 0;
    font-size: 15.6cqi; /* "EDUCATION" fills the column width */
    line-height: 0.8;
    white-space: nowrap;
    letter-spacing: -0.005em;
  }

  .edu__word--main {
    position: absolute;
    left: 0;
    top: var(--wy, 0px);
    color: var(--ink);
  }

  .edu__word--knock {
    position: absolute;
    left: 0;
    top: calc(var(--wy, 0px) - var(--pt, 0px));
    color: var(--paper);
    pointer-events: none;
  }

  .edu__art :global(.edu__shell) {
    position: absolute;
    left: 0;
    margin: 0;
    font-size: 15.6cqi;
    line-height: 0.8;
    white-space: nowrap;
    letter-spacing: -0.005em;
    color: transparent;
    -webkit-text-stroke: 1.2px var(--ink);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }

  .edu__art :global(.edu__shell.is-left) {
    opacity: var(--o, 0.5);
  }

  /* the copy left on the painting where the word started: white, like the word was */
  .edu__art :global(.edu__shell--paint) {
    color: var(--paper);
    -webkit-text-stroke: 0;
  }

  @media (max-width: 900px) {
    .edu__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .edu__art {
      order: -1;
      padding-bottom: 12cqi;
    }
  }
</style>
