---
import { Image } from 'astro:assets';
import Boards from './Boards.astro';
import almond from '../assets/hero/almond-blossom.jpg';
---

<header class="hero">
  <Boards />

  <div class="frame">
    <!-- Van Gogh, Almond Blossom (1890, public domain), at the back of the block -->
    <Image
      src={almond}
      alt=""
      widths={[800, 1300, 1900, 2400]}
      sizes="min(66vw, 1120px)"
      class="frame__art"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="title">
      <span class="sr-only">Jeffrey Wu</span>
      <!-- The SVG is stretched to fill its box (preserveAspectRatio="none"):
           width stays the frame width, only the height grows. The viewBox is
           tightened to the real glyph bounds by the script below. -->
      <svg
        class="title__svg"
        viewBox="2 -73 633.2 74"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <text x="0" y="0">JEFFREY WU</text>
      </svg>
    </h1>
    <p class="subtitle heading">Portfolio &amp; Blogs</p>
    <p
      class="art-caption hero__caption"
      data-note="The most beautiful painting, in my opinion. Different from his normal work, it is a symbol of hope and a symbol of care."
    >
      * Vincent van Gogh, <em>Almond Blossom</em>, 1890</p>
  </div>

  <!-- looks like a menu icon, but opens no menu: it glides down to Lonely Ocean, where the top bar appears -->
  <a class="hero__list" href="#about" data-hero-jump aria-label="Go to Lonely Ocean">
    <svg viewBox="0 0 28 22" aria-hidden="true" focusable="false">
      <path d="M1.5 3h25M1.5 11h25M1.5 19h25"></path>
    </svg>
  </a>

  <a class="scroll-hint" href="#about" data-hero-jump>
    <span class="sr-only">Skip to the next section</span>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
      ><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
      ></path></svg
    >
  </a>
</header>

<script>
  import { scrollUnderBar } from '../scroll';

  // Fit the title's viewBox to the actual ink bounds of "JEFFREY WU" (same font as
  // PORTFOLIO & BLOGS), so the stretched letters touch the edges of their box exactly.
  async function fitTitle() {
    const svg = document.querySelector<SVGSVGElement>('.title__svg');
    const text = svg?.querySelector('text');
    if (!svg || !text) return;
    const style = getComputedStyle(text);
    const font = `${style.fontWeight} 100px ${style.fontFamily}`;
    try {
      await document.fonts.load(font, 'JEFFREY WU');
    } catch {
      /* keep the default viewBox */
    }
    const ctx = document.createElement('canvas').getContext('2d');
    if (!ctx) return;
    ctx.font = font;
    const m = ctx.measureText('JEFFREY WU');
    const left = m.actualBoundingBoxLeft;
    const width = left + m.actualBoundingBoxRight;
    const top = m.actualBoundingBoxAscent;
    const height = top + m.actualBoundingBoxDescent;
    if (width > 0 && height > 0) {
      svg.setAttribute('viewBox', `${-left} ${-top} ${width} ${height}`);
    }
  }
  fitTitle();

  // The hamburger icon and the down arrow: land with ELECTRICAL just under the top bar, so the whole Lonely Ocean
  // shows (the bar appears by itself once #about reaches the top of the screen). Without JavaScript the plain #about
  // link still works.
  const ocean = document.querySelector<HTMLElement>('#about [data-reveal]');
  document.querySelectorAll('[data-hero-jump]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (!ocean) return;
      e.preventDefault();
      scrollUnderBar(ocean, 28);
    });
  });
</script>

<style>
  .hero {
    /* frame width; everything inside scales from it */
    --fw: min(66vw, 1120px);
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 9vh var(--gutter);
    /* transparent: the sky comes from the page background behind the boards */
    background: transparent;
  }

  .frame {
    position: relative;
    width: var(--fw);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: calc(var(--fw) * 0.018);
    padding: calc(var(--fw) * 0.04) calc(var(--fw) * 0.045) calc(var(--fw) * 0.032);
  }

  /* the painting fills the block; under the boards and the text */
  .frame__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  /* the thin butter rectangle, drawn on top of the painting's edge; under the boards */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border: max(3px, calc(var(--fw) * 0.0055)) solid var(--butter);
    pointer-events: none;
  }

  .title,
  .subtitle {
    position: relative;
    z-index: 2; /* above the boards */
    margin: 0;
  }

  /* painting credit, just under the frame */
  .hero__caption {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 100%;
    margin-top: 0.7rem;
    color: rgb(64 64 64 / 0.62);
  }

  .title {
    font-weight: 400;
    line-height: 0;
  }

  .title__svg {
    display: block;
    width: 100%;
    /* stretch vertically until it nearly meets PORTFOLIO & BLOGS,
       capped relative to the width so it never gets absurd */
    height: min(36vh, calc(var(--fw) * 0.36));
    min-height: calc(var(--fw) * 0.12);
    overflow: visible;
  }

  /* same face as PORTFOLIO & BLOGS (the .heading style) */
  .title__svg text {
    font-family: var(--font-sans);
    font-size: 100px;
    font-weight: 800;
    fill: var(--butter);
    text-rendering: geometricPrecision;
  }

  .subtitle {
    color: var(--butter);
    text-align: center;
    font-size: calc(var(--fw) * 0.064);
    letter-spacing: 0.005em;
    line-height: 0.9;
    white-space: nowrap;
  }

  /* the hamburger icon, top left: three lines */
  .hero__list {
    position: absolute;
    z-index: 2;
    left: max(12px, 1.6vw);
    top: max(12px, 2vh);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--ink);
    opacity: 0.72;
    transition: opacity 0.25s var(--ease);
  }

  .hero__list svg {
    width: 30px;
    height: auto;
    overflow: visible;
  }

  .hero__list path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .hero__list:hover,
  .hero__list:focus-visible {
    opacity: 1;
  }

  .scroll-hint {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: max(16px, 3vh);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    opacity: 0.55;
    transition:
      opacity 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .scroll-hint:hover,
  .scroll-hint:focus-visible {
    opacity: 1;
  }

  @media (max-width: 700px) {
    .hero {
      --fw: calc(100vw - 2 * var(--gutter));
    }
    .title__svg {
      height: min(30vh, calc(var(--fw) * 0.42));
    }
    .subtitle {
      font-size: calc(var(--fw) * 0.072);
    }
    /* smaller lines on phones; the tap area stays the same */
    .hero__list svg {
      width: 22px;
    }
  }
</style>
