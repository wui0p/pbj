---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BackLink from './BackLink.astro';
import mondrian from '../assets/misc/mondrian.jpg';

// Misc: Mondrian against the left wall with MISC. in white on its red square, the
// two lines beside it, then the questions. Each answer stays hidden until its question is clicked.
interface Props {
  backHref: string;
}

const { backHref } = Astro.props;
const questions = await Promise.all(
  (await getCollection('misc'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (q) => ({ ...q, Content: (await render(q)).Content })),
);
---

<div class="misc">
  <div class="misc__top">
    <div class="misc__paint">
      <Image
        src={mondrian}
        alt="Piet Mondrian's Composition with Red, Blue and Yellow: a large red square, a small blue and a small yellow block, divided by thick black lines on white"
        widths={[500, 800, 1100, 1400]}
        sizes="(max-width: 760px) 100vw, 53vw"
        class="misc__img"
        loading="eager"
      />
      <h1 class="heading misc__title">Misc.<span class="misc__sub">miscellaneous</span></h1>
    </div>
    <div class="misc__side">
      <p
        class="art-caption misc__caption"
        data-note="This is one of my high school friends’ favorite paintings. I enjoy this abstract painting because of how clean and quiet it feels. It is simple, but it still consists of different colors that find a balance. Just like a human—a life."
      >
        * Piet Mondrian, <em>Composition with Red, Blue and Yellow</em>, 1930
      </p>
      <div class="misc__lines">
        <p class="heading misc__line">Not achievements, not projects</p>
        <p class="heading misc__line">Just small, random things about me</p>
      </div>
    </div>
  </div>

  <div class="wrap misc__list">
    <BackLink href={backHref} label="Main page" class="misc__back" />
    {
      questions.map(({ id, data, Content }) => (
        <details class="qa" id={id}>
          <summary class="qa__q">
            <h2 class="heading qa__text">{data.question}</h2>
            <svg class="qa__arrow" viewBox="0 0 32 20" aria-hidden="true" focusable="false">
              <path d="M0 0h9.5L16 7.5 22.5 0H32L16 20Z" />
            </svg>
          </summary>
          <div class:list={['qa__a', { 'qa__a--photo': data.photo && data.photoAt === 'side' }]}>
            {data.photo && data.photoAt === 'side' && (
              <figure class="qa__fig">
                <Image src={data.photo} alt={data.photoAlt ?? ''} widths={[320, 626]} sizes="300px" class="qa__img" />
                {data.photoCaption && <figcaption class="art-caption">* {data.photoCaption}</figcaption>}
              </figure>
            )}
            <div class="qa__text-body">
              <Content />
            </div>
            {data.photo && data.photoAt === 'below' && (
              <figure class="qa__fig qa__fig--below">
                <Image
                  src={data.photo}
                  alt={data.photoAlt ?? ''}
                  widths={[640, 1000, 1600]}
                  sizes="(max-width: 1040px) 100vw, 980px"
                  class="qa__img"
                />
                {data.photoCaption && <figcaption class="art-caption">* {data.photoCaption}</figcaption>}
              </figure>
            )}
            {data.photo && data.photo2 && data.photoAt === 'pair' && (
              <figure class:list={['qa__fig qa__fig--pair', { 'qa__fig--three': data.photo3 }]}>
                <div class="qa__pair">
                  {[
                    { src: data.photo, alt: data.photoAlt },
                    { src: data.photo2, alt: data.photo2Alt },
                    ...(data.photo3 ? [{ src: data.photo3, alt: data.photo3Alt }] : []),
                  ].map((p) => (
                    <Image
                      src={p.src}
                      alt={p.alt ?? ''}
                      widths={[300, 600, 800]}
                      sizes="(max-width: 760px) 45vw, 380px"
                      class="qa__img"
                      style={`--ratio: ${p.src.width / p.src.height}`}
                    />
                  ))}
                </div>
                {data.photoCaption && <figcaption class="art-caption">* {data.photoCaption}</figcaption>}
              </figure>
            )}
            {data.photo && data.photo2 && data.photoAt === 'row' && (
              <figure class="qa__fig qa__fig--row">
                <div class="qa__row">
                  {[
                    { src: data.photo, alt: data.photoAlt },
                    { src: data.photo2, alt: data.photo2Alt },
                  ].map((p) => (
                    <Image src={p.src} alt={p.alt ?? ''} widths={[600, 1000]} sizes="(max-width: 600px) 100vw, 490px" class="qa__img" />
                  ))}
                </div>
                {data.photoCaption && <figcaption class="art-caption">* {data.photoCaption}</figcaption>}
              </figure>
            )}
          </div>
        </details>
      ))
    }
  </div>
</div>

<script>
  // a link straight to a question (…/misc/#formula-1) opens its answer
  const open = () => {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  addEventListener('hashchange', open);
</script>

<style>
  /* ----- Mondrian against the left wall, the two lines beside it ----- */
  .misc__top {
    display: grid;
    grid-template-columns: 53% minmax(0, 1fr);
    column-gap: clamp(20px, 2.4vw, 40px);
  }

  .misc__paint {
    position: relative;
    container-type: inline-size;
  }

  .misc__paint :global(.misc__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* MISC. in white, inside the big red square */
  .misc__title {
    position: absolute;
    left: 29cqi;
    top: 23cqi;
    margin: 0;
    color: var(--paper);
    font-size: 17cqi;
    line-height: 1;
    white-space: nowrap;
  }

  /* "miscellaneous", small white bold right under MISC. */
  .misc__sub {
    display: block;
    margin-top: 0.6cqi;
    padding-left: 0.6cqi; /* lines up with the M's stem */
    font-size: 4.2cqi;
    font-weight: 800;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .misc__side {
    display: flex;
    flex-direction: column;
    padding-right: var(--gutter);
  }

  .misc__caption {
    width: fit-content;
    margin-top: clamp(8px, 1vw, 14px);
  }

  /* no full stops on these two */
  .misc__lines {
    margin-top: auto;
    padding: clamp(32px, 4vw, 64px) 0 clamp(40px, 9.5vw, 150px); /* sits a little above the painting's bottom */
    display: grid;
    gap: clamp(28px, 3.6vw, 60px);
  }

  .misc__line {
    margin: 0;
    font-size: clamp(1.6rem, 3.3vw, 3.4rem);
    line-height: 1.12;
    color: var(--ink);
    text-wrap: balance;
  }

  /* ----- the questions ----- */
  .misc__list {
    max-width: 1000px;
    padding-top: clamp(72px, 9vw, 130px);
    padding-bottom: clamp(56px, 7vw, 110px);
  }

  .misc__list :global(.misc__back) {
    margin: 0 0 clamp(12px, 1.4vw, 18px) clamp(4px, 1vw, 12px);
  }

  .qa + .qa {
    margin-top: clamp(30px, 3.4vw, 48px);
  }

  /* a link to a question lands it a third of the way down the screen (--jump-at), its answer open under it */
  .qa {
    scroll-margin-top: var(--jump-at);
  }

  /* the question: big uppercase with a thick ink rule under it, the arrow on the right */
  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 clamp(4px, 1vw, 12px) 0.45em;
    border-bottom: 4px solid var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q:focus-visible {
    outline: 3px solid var(--butter);
    outline-offset: 6px;
  }

  .qa__text {
    font-size: clamp(1.25rem, 2.3vw, 2.1rem);
    line-height: 1.12;
  }

  /* points down while the answer is hidden, flips up when it opens */
  .qa__arrow {
    flex: none;
    width: clamp(26px, 2.6vw, 38px);
    fill: var(--ink);
    transition: transform 0.35s var(--ease);
  }

  .qa__q:hover .qa__arrow {
    transform: translateY(3px);
  }

  .qa[open] .qa__arrow {
    transform: rotate(180deg);
  }

  .qa[open] .qa__q:hover .qa__arrow {
    transform: rotate(180deg) translateY(3px);
  }

  /* the answer slides open where the browser can animate it (and simply appears elsewhere) */
  .qa {
    interpolate-size: allow-keywords;
  }

  .qa::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s var(--ease),
      content-visibility 0.4s allow-discrete;
  }

  .qa[open]::details-content {
    block-size: auto;
  }

  .qa__a {
    padding: clamp(18px, 2.2vw, 30px) clamp(4px, 1vw, 12px) clamp(8px, 1vw, 14px);
  }

  .qa__a--photo {
    display: grid;
    grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
  }

  .qa__fig {
    margin: 0;
  }

  /* a wide picture across the answer, under its text */
  .qa__fig--below {
    margin-top: clamp(22px, 2.6vw, 34px);
  }

  .qa__fig :global(.qa__img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* two tall pages side by side, kept short so the answer doesn't run long; the caption beside them, at the bottom */
  .qa__fig--pair {
    margin-top: clamp(22px, 2.6vw, 34px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 8px clamp(14px, 1.6vw, 22px);
  }

  .qa__pair {
    display: flex;
    gap: clamp(6px, 0.8vw, 10px);
  }

  .qa__fig--pair :global(.qa__img) {
    width: auto;
    height: clamp(260px, 28vw, 380px);
  }

  .qa__fig--pair figcaption {
    margin: 0;
  }

  /* three pictures: one row filling the width, all the same height (each grows by its width-to-height ratio),
     the caption under them */
  .qa__fig--three {
    display: block;
  }

  .qa__fig--three .qa__pair {
    margin-bottom: 8px;
  }

  .qa__fig--three :global(.qa__img) {
    flex: var(--ratio) 1 0;
    min-width: 0;
    width: 0;
    height: auto;
  }

  /* two wide pictures side by side across the answer, the caption under them */
  .qa__fig--row {
    margin-top: clamp(22px, 2.6vw, 34px);
  }

  .qa__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 14px);
    margin-bottom: 8px;
  }

  .qa__text-body :global(p) {
    margin: 0;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.6;
    text-align: justify;
    color: var(--ink);
  }

  .qa__text-body :global(p + p) {
    margin-top: 1.1em;
  }

  .qa__text-body :global(sup) {
    font-size: 0.65em;
    line-height: 0;
  }

  /* links read like a document's: underlined text */
  .qa__text-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-thickness 0.2s var(--ease);
  }

  .qa__text-body :global(a:hover),
  .qa__text-body :global(a:focus-visible) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 760px) {
    /* phones: the painting, then the two lines under it; a picture above its answer */
    .misc__top {
      grid-template-columns: minmax(0, 1fr);
    }
    .misc__side {
      padding-left: var(--gutter);
    }
    .misc__caption {
      margin-left: 0;
    }
    .misc__lines {
      padding-top: 36px;
    }
    .misc__line {
      font-size: 1.9rem;
    }
    .qa__a--photo {
      grid-template-columns: minmax(0, 1fr);
    }
    .qa__a--photo .qa__fig {
      max-width: 260px;
    }
    /* phones: the two pages share the width, the caption under them */
    .qa__pair {
      width: 100%;
    }
    .qa__fig--pair :global(.qa__img) {
      flex: 1 1 0;
      min-width: 0;
      width: 100%;
      height: auto;
    }
    /* three pictures: the first two share a row, the third gets the full width under them */
    .qa__fig--three .qa__pair {
      flex-wrap: wrap;
    }
    .qa__fig--three :global(.qa__img) {
      flex: var(--ratio) 1 0;
      width: 0;
    }
    .qa__fig--three :global(.qa__img:nth-child(3)) {
      flex-basis: 100%;
    }
  }

  /* small phones: the two wide pictures one under the other, so they aren't too small to see */
  @media (max-width: 600px) {
    .qa__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa::details-content,
    .qa__arrow {
      transition: none;
    }
  }
</style>
