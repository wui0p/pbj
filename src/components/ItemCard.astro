---
// One block on a category page.
// - small block: the whole block is a link (its post page, or an outside link) and its border glows butter on hover;
//   a Google Drive file/folder says so before its description ([PDF] / [Folder])
// - placeholder: can't be opened; hovering shows "This blog is under construction…"
// - big block (`buttons:` in the frontmatter): flat and still; only its 3D buttons are interactive
import BlockButtons from './BlockButtons.astro';
import { UNDER_CONSTRUCTION, itemHref, langOf, linkKind, metaText, type Post } from '../utils';

interface Props {
  post: Post;
  /** heading level inside the page */
  as?: 'h2' | 'h3';
}

const { post, as: Title = 'h3' } = Astro.props;
const { title, summary, pinned, buttons, placeholder } = post.data;
const meta = metaText(post);
const kind = linkKind(post);
const { href, external } = itemHref(post);
const noteId = `${post.id}-soon`;
---

{
  buttons ? (
    <div class="card item item--block" id={post.id} lang={langOf(title)}>
      <div class="card__meta item__meta">
        {meta && <span class="eyebrow">{meta}</span>}
        {pinned && (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <span class="eyebrow">Pinned</span>
          </>
        )}
      </div>
      <Title class="card__title item__title">{title}</Title>
      {summary && <p class="card__summary">{summary}</p>}
      <BlockButtons buttons={buttons} idPrefix={post.id} class="item__buttons" />
    </div>
  ) : placeholder ? (
    <div class="card item soon" id={post.id} lang={langOf(title)} tabindex="0" aria-describedby={noteId}>
      {(meta || pinned) && (
        <div class="card__meta item__meta">
          {meta && <span class="eyebrow">{meta}</span>}
          {pinned && <span class="eyebrow">Pinned</span>}
        </div>
      )}
      <Title class="card__title item__title">{title}</Title>
      {summary && <p class="card__summary">{summary}</p>}
      <span class="soon__note" id={noteId} role="tooltip">
        {UNDER_CONSTRUCTION}
      </span>
    </div>
  ) : (
    <a
      class="card item"
      id={post.id}
      href={href}
      lang={langOf(title)}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      {(meta || pinned) && (
        <div class="card__meta item__meta">
          {meta && <span class="eyebrow">{meta}</span>}
          {meta && pinned && (
            <span class="dot" aria-hidden="true">
              ·
            </span>
          )}
          {pinned && <span class="eyebrow">Pinned</span>}
        </div>
      )}
      <Title class="card__title item__title">{title}</Title>
      {summary && (
        <p class="card__summary">
          {kind && <span class="link-kind">[{kind}]</span>} {summary}
        </p>
      )}
      {external && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  )
}

<style>
  .item {
    height: 100%;
    border-radius: clamp(22px, 2.4vw, 34px);
    padding: clamp(20px, 2.4vw, 34px) clamp(22px, 2.6vw, 38px);
  }

  .item__title {
    font-size: clamp(1.3rem, 2vw, 1.85rem);
    margin-bottom: 0.4rem;
  }

  .item :global(.item__buttons) {
    margin-top: clamp(18px, 2vw, 26px);
  }
</style>
