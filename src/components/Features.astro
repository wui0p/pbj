---
import { categoryLabel, dateText, isoDate, itemHref, langOf, type Post } from '../utils';

interface Props {
  posts: Post[];
}

// The three newest dated posts that aren't already in Pinned Items (and aren't placeholders).
const news = Astro.props.posts.filter((p) => p.data.date && !p.data.pinned && !p.data.placeholder).slice(0, 3);

// one important word per post (frontmatter `keyword`), falling back to the category
const word = (p: Post) => (p.data.keyword ?? categoryLabel(p.data.category)).toUpperCase();
const wordSize = (w: string) => (w.length <= 5 ? 'l' : w.length <= 8 ? 'm' : 's');
---

{
  news.length > 0 && (
    <section class="news" aria-labelledby="news-heading">
      <div class="wrap">
        <div class="news__head">
          <h2 class="heading news__title" id="news-heading">
            Newest News
          </h2>
          <span class="news__rule" aria-hidden="true" />
          <p class="heading news__sub">See what's new here?</p>
        </div>

        <ul class="news__grid">
          {news.map((post) => {
            const { href, external } = itemHref(post);
            const date = post.data.date!;
            return (
              <li>
                <a
                  class="news__card depth"
                  href={href}
                  lang={langOf(post.data.title)}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span class={`news__word news__word--${wordSize(word(post))}`} aria-hidden="true">
                    {word(post)}
                  </span>
                  <span class="news__meta eyebrow">
                    {categoryLabel(post.data.category)} · <time datetime={isoDate(date)}>{dateText(post)}</time>
                  </span>
                  <span class="news__name">{post.data.title}</span>
                  {post.data.summary && <span class="news__summary">{post.data.summary}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .news {
    background: var(--paper);
    padding: clamp(8px, 1.5vw, 24px) 0 var(--sec-bot); /* close under The Menu: same kind of section */
  }

  .news__head {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .news__title {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  /* thin divider between NEWS and SEE */
  .news__rule {
    width: 1.5px;
    align-self: stretch;
    background: var(--ink);
    margin: 0.2em 0 0.1em;
  }

  .news__sub {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    padding-bottom: 0.12em;
  }

  .news__grid {
    list-style: none;
    margin: 0;
    padding: 0 10px 10px 0; /* room for the blocks' sides */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3.5vw, 56px);
  }

  .news__card {
    --depth: 10px;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: clamp(260px, 24vw, 340px);
    padding: clamp(22px, 2.4vw, 32px);
    background: var(--sand);
    border: 3px solid var(--sand);
    border-radius: clamp(28px, 3vw, 44px);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.25s var(--ease);
  }

  /* like the pinned cards: only the border turns butter */
  .news__card:hover,
  .news__card:focus-visible {
    border-color: var(--butter);
    outline: none;
  }

  /* the post's one keyword, in the heading sans */
  .news__word {
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.01em;
    margin-bottom: auto;
    padding-bottom: 1.2rem;
    overflow-wrap: anywhere;
  }
  .news__word--l {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
  }
  .news__word--m {
    font-size: clamp(1.9rem, 3vw, 2.7rem);
  }
  .news__word--s {
    font-size: clamp(1.5rem, 2.3vw, 2.1rem);
  }

  .news__meta {
    margin-bottom: 0.4rem;
  }

  .news__name {
    font-weight: 700;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.3;
    margin-bottom: 0.4rem;
    text-wrap: balance;
  }

  .news__summary {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .news__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .news__card {
      min-height: 0;
    }
  }
</style>
